<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/btn_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Your Name"
            android:background="@drawable/bg_card"
            android:padding="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Doctor"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <Spinner
            android:id="@+id/doctorSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_card"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tap to pick date"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Time Slot"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <Spinner
            android:id="@+id/timeSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_card"/>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Confirm Booking"
            android:backgroundTint="@color/accent"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"/>
        <ImageView
            android:id="@+id/doctorImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/doc1"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/doctorDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doctor Description"
            android:textAlignment="center"
            android:layout_marginTop="5dp"/>
        <TextView
            android:id="@+id/slotInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remaining Slots: 10/10"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>